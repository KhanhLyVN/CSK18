// ======================================================
// 5. DO POST - AI CHAT (ĐÃ CẬP NHẬT THEO YÊU CẦU)
// ======================================================

function doPost(e) {
  try {

    // Nhận dữ liệu từ faq.html dạng form-urlencoded
    const question = e.parameter.question || "";

    const history = e.parameter.history
      ? JSON.parse(e.parameter.history)
      : [];

    const faqContext = e.parameter.faqContext
      ? JSON.parse(e.parameter.faqContext)
      : [];


    if (!question.trim()) {
      return jsonResponse({
        success: false,
        error: "Câu hỏi trống."
      });
    }


    const apiKey = PropertiesService
      .getScriptProperties()
      .getProperty("GEMINI_API_KEY");


    if (!apiKey) {
      throw new Error(
        "Chưa cấu hình GEMINI_API_KEY"
      );
    }


    // ==============================
    // FAQ CONTEXT
    // ==============================

    const contextText = faqContext.length
      ? faqContext.map((faq, index) => `
FAQ ${index + 1}

Chủ đề: ${faq.category || "Không xác định"}

Câu hỏi: ${faq.question || ""}

Trả lời: ${faq.answer || ""}
      `).join("\n\n")
      : "Không có FAQ phù hợp được tìm thấy.";


    // ==============================
    // LỊCH SỬ HỘI THOẠI
    // ==============================

    const historyText = history.length
      ? history.map(item =>
          `${item.role === "user" ? "Student" : "AI"}: ${item.text || item.content || ""}`
        ).join("\n")
      : "Chưa có lịch sử hội thoại.";


    // ==============================
    // PROMPT DẠY AI
    // ==============================

    const prompt = `

Bạn là AI hỗ trợ Customer Success của CS Center.

NHIỆM VỤ:

Bạn đang hỗ trợ học viên (Student) của trung tâm.

Luôn trả lời bằng tiếng Việt.

Phong cách:
- Thân thiện.
- Lịch sự.
- Ngắn gọn.
- Dễ hiểu.
- Không trả lời máy móc.
- Không nói rằng bạn đang phân tích dữ liệu.


========================================
1. NGUYÊN TẮC SỬ DỤNG FAQ
========================================

- Ưu tiên sử dụng thông tin trong FAQ được cung cấp.
- FAQ là nguồn thông tin chính thức để trả lời.
- Không được tự bịa thông tin.
- Không được tự suy đoán chính sách.
- Không được tự tạo ra học phí, lịch học, quy định hoặc quyền lợi.


========================================
2. KHI FAQ KHÔNG CÓ THÔNG TIN
========================================

Nếu câu hỏi không có thông tin phù hợp trong FAQ:

KHÔNG được đoán.

Hãy trả lời theo hướng:

"Mình chưa tìm thấy thông tin chính xác về vấn đề này trong dữ liệu hiện tại. Bạn vui lòng liên hệ Customer Success để được hỗ trợ chính xác nhé."


========================================
3. CÂU HỎI VỀ HỌC PHÍ
========================================

Nếu Student hỏi:

- Học phí bao nhiêu?
- Khóa học bao nhiêu tiền?
- Giá khóa học?
- Học phí khóa này?
- Phí đăng ký?
- Bao nhiêu tiền?
- Có giảm giá không?
- Có ưu đãi không?

KHÔNG được cung cấp con số tiền cụ thể.

KHÔNG được lấy con số học phí từ FAQ để trả lời trực tiếp.

Hãy hướng dẫn Student liên hệ Customer Success.

Ví dụ câu trả lời:

"Về học phí, mình chưa thể cung cấp mức phí cụ thể tại đây. Bạn vui lòng liên hệ Customer Success để được tư vấn mức học phí và chính sách áp dụng chính xác nhé! 😊"


========================================
4. THÔNG TIN NHẠY CẢM
========================================

Nếu câu hỏi liên quan đến:

- Học phí
- Thanh toán
- Hoàn tiền
- Ưu đãi riêng
- Chính sách cá nhân
- Thông tin tài khoản
- Thông tin thanh toán
- Các trường hợp cần xác nhận riêng

Không tự quyết định.

Không tự đưa ra cam kết.

Hướng dẫn Student liên hệ Customer Success.


========================================
5. CÂU HỎI THÔNG THƯỜNG
========================================

Nếu FAQ có thông tin phù hợp và câu hỏi không thuộc nhóm nhạy cảm:

→ Có thể trả lời dựa trên FAQ.

Có thể diễn đạt lại câu trả lời để tự nhiên hơn nhưng:

KHÔNG được làm thay đổi ý nghĩa của FAQ.


========================================
6. LỊCH SỬ HỘI THOẠI
========================================

Sử dụng lịch sử hội thoại để hiểu ngữ cảnh.

Nếu Student hỏi tiếp:

Ví dụ:

Student:
"Lịch học thế nào?"

Student:
"Còn khóa buổi tối?"

Hãy hiểu câu hỏi thứ hai dựa trên câu hỏi trước.

Không yêu cầu Student lặp lại thông tin nếu có thể hiểu được từ lịch sử.


========================================
LỊCH SỬ HỘI THOẠI:

${historyText}


========================================
FAQ LIÊN QUAN:

${contextText}


========================================
CÂU HỎI HIỆN TẠI:

${question}

`;


    // ==============================
    // GỌI GEMINI
    // ==============================

    const url =
      "https://generativelanguage.googleapis.com/v1beta/models/" +
      GEMINI_MODEL +
      ":generateContent";


    const payload = {
      contents: [
        {
          role: "user",
          parts: [
            {
              text: prompt
            }
          ]
        }
      ]
    };


    const response = UrlFetchApp.fetch(url, {
      method: "post",

      contentType: "application/json",

      headers: {
        "x-goog-api-key": apiKey
      },

      payload: JSON.stringify(payload),

      muteHttpExceptions: true
    });


    const code =
      response.getResponseCode();

    const responseText =
      response.getContentText();


    console.log(
      "HTTP CODE:",
      code
    );

    console.log(
      responseText
    );


    if (code !== 200) {
      throw new Error(
        "Gemini API lỗi " +
        code +
        ": " +
        responseText
      );
    }


    const result =
      JSON.parse(responseText);


    const answer =
      result.candidates?.[0]
        ?.content
        ?.parts?.[0]
        ?.text ||
      "Xin lỗi, mình chưa thể trả lời câu hỏi này.";


    console.log(
      "AI trả lời:",
      answer
    );


    return jsonResponse({
      success: true,
      answer: answer
    });


  } catch (error) {

    console.error(
      "DOPOST ERROR:",
      error
    );


    return jsonResponse({
      success: false,
      error: error.message
    });

  }
}


