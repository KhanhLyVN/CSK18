// ======================================================
// 3. PHÁT HIỆN CÂU HỎI NHẠY CẢM
// ======================================================

function normalizeText(text) {
  if (!text) return "";

  return text
    .toString()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/đ/g, "d")
    .trim();
}


function detectSensitiveQuestion(question) {

  const text = normalizeText(question);

  // ------------------------------------------
  // HỌC PHÍ / GIÁ TIỀN
  // ------------------------------------------

  const tuitionKeywords = [
    "hoc phi",
    "bao nhieu tien",
    "bao nhieu",
    "gia khoa hoc",
    "gia khoa",
    "chi phi khoa hoc",
    "chi phi",
    "tien hoc",
    "hoc phi bao nhieu",
    "dong bao nhieu",
    "phi hoc",
    "muc hoc phi"
  ];

  if (tuitionKeywords.some(keyword => text.includes(keyword))) {
    return "TUITION";
  }


  // ------------------------------------------
  // THÔNG TIN THANH TOÁN CÁ NHÂN
  // ------------------------------------------

  const personalPaymentKeywords = [
    "toi da dong hoc phi chua",
    "toi da thanh toan chua",
    "toi con no bao nhieu",
    "con no bao nhieu",
    "tai khoan cua toi",
    "thanh toan cua toi",
    "lich su thanh toan cua toi",
    "don hang cua toi"
  ];

  if (
    personalPaymentKeywords.some(keyword =>
      text.includes(keyword)
    )
  ) {
    return "PERSONAL_PAYMENT";
  }


  // ------------------------------------------
  // KHIẾU NẠI / PHẢN ÁNH
  // ------------------------------------------

  const complaintKeywords = [
    "khieu nai",
    "phan anh",
    "khong hai long",
    "buc xuc",
    "khong hai long ve",
    "muon khieu nai",
    "toi muon phan anh"
  ];

  if (
    complaintKeywords.some(keyword =>
      text.includes(keyword)
    )
  ) {
    return "COMPLAINT";
  }


  // ------------------------------------------
  // THÔNG TIN CÁ NHÂN / TÀI KHOẢN
  // ------------------------------------------

  const personalKeywords = [
    "mat khau cua toi",
    "tai khoan cua toi",
    "email cua toi",
    "thong tin ca nhan cua toi",
    "du lieu cua toi"
  ];

  if (
    personalKeywords.some(keyword =>
      text.includes(keyword)
    )
  ) {
    return "PERSONAL_DATA";
  }


  return null;
}


